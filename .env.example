# Environment Variables Template
PROJECT_NAME="ARM - Axborot Resurs Markazi"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="arm-super-secret-key-change-in-production-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
PORT=8000
HOST="0.0.0.0"

# Database (Default: SQLite async, PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/arm_db)
DATABASE_URL="sqlite+aiosqlite:///./arm.db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","http://127.0.0.1:5500"]

# AI Agent Settings (Optional / Fallback mock if empty)
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
